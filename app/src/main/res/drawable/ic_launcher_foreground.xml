<?xml version="1.0" encoding="utf-8"?>
<!--
  图标前景：播放三角 + 带箭头的开口环（媒体播放器「自动重播」的通用语言）。
  矢量绘制，任意分辨率都清晰；图形全部落在自适应图标的中央安全区内（66/108）。

  坐标来自设计稿的 512×512 画布，用 group 缩放平移到 108 视口：
  缩放 0.1838，平移 (7.77, 6.95) —— 使图形包围盒中心落在 (54,54)。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.1838"
        android:scaleY="0.1838"
        android:translateX="7.77"
        android:translateY="6.95">

        <!-- 开口圆环 -->
        <path
            android:pathData="M256,104 A152,152 0 1 1 127,179"
            android:strokeColor="#1A1200"
            android:strokeLineCap="butt"
            android:strokeWidth="46" />

        <!-- 环末端的箭头（顺时针方向的切线） -->
        <path
            android:fillColor="#1A1200"
            android:pathData="M72.141,181.503 L149.33,141.09 L151.409,228.193 Z" />

        <!-- 中央播放三角 -->
        <path
            android:fillColor="#1A1200"
            android:pathData="M228,190 L326,256 L228,322 Z" />
    </group>
</vector>
